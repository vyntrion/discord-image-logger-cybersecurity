# Discord Image Logger — environment template
#
# Copy to `.env` and fill in locally. NEVER commit a populated `.env`.
#   cp .env.example .env
#
# main.py loads `.env` automatically at start-up: one `KEY=VALUE` per line,
# `#` comments ignored. A variable already exported in your shell always wins
# over this file, and every key below can also be set in `config.json`.
#
# Precedence:  shell  >  .env  >  config.json  >  built-in default

# Bot token — reserved for forks that add an inbound Discord bot.
# This build integrates through an outbound webhook only, so it is unused.
DISCORD_TOKEN=

# Outbound Discord webhook used for authorized event notifications.
# Replace with a webhook you created in a server you administer.
# Honoured as WEBHOOK_URL (or the project-specific IMAGE_LOGGER_WEBHOOK).
WEBHOOK_URL=

# Fixed tunnel URL to advertise instead of launching one — e.g. a Caddy
# reverse proxy or a static ngrok domain. Honoured by run.py.
TUNNEL_URL=

# Console verbosity: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# Retention window for collected events, in days.
# Enforced: the archive is pruned at boot and then hourly. 0 = keep forever.
DATA_RETENTION_DAYS=7

# Largest accepted request body / preview image, in megabytes.
# Enforced: oversized POST bodies get 413; preview fetches are capped.
MAX_IMAGE_SIZE_MB=10

# Optional: ngrok authtoken (only needed for --tunnel ngrok).
# Leave commented out to skip ngrok entirely.
# NGROK_AUTHTOKEN=
