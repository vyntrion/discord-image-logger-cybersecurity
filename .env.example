# Discord Image Logger — environment template
#
# Copy to `.env` and fill in locally. NEVER commit a populated `.env`.
#   cp .env.example .env
#
# This repository's runtime currently reads configuration from `config.json`
# plus the environment variables listed as "Honoured" below. Entries marked
# [VERIFY AGAINST IMPLEMENTATION] are reserved for deployments that standardise
# on environment files — they are not consumed by the current code.

# Bot token — only if your deployment includes an inbound Discord bot.
# Leave empty otherwise. [VERIFY AGAINST IMPLEMENTATION]
DISCORD_TOKEN=

# Outbound Discord webhook used for authorized event notifications.
# Replace with a webhook you created in a server you administer.
# Honoured via: IMAGE_LOGGER_WEBHOOK
WEBHOOK_URL=

# Fixed tunnel URL advertised to collaborators, if you use one.
# [VERIFY AGAINST IMPLEMENTATION] — at launch the URL is discovered from the
# tunnel provider and printed to the console.
TUNNEL_URL=

# Console verbosity. [VERIFY AGAINST IMPLEMENTATION]
LOG_LEVEL=INFO

# Intended retention policy for collected events, in days.
# NOT ENFORCED YET — pruning is manual; see README → Data Retention.
DATA_RETENTION_DAYS=7

# Largest accepted image, in megabytes.
# NOT ENFORCED YET — see README → Threat Model.
MAX_IMAGE_SIZE_MB=10

# Optional: ngrok authtoken (honoured as NGROK_AUTHTOKEN, or set
# config.json → ngrokAuthtoken). Leave empty to skip ngrok entirely.
# NGROK_AUTHTOKEN=
